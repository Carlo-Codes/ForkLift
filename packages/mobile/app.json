{
  "expo": {
    "name": "ForkLift",
    "slug": "forklift",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "forklift",
    "ios": {
      "bundleIdentifier": "app.forklift",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "AI Access lets an AI assistant on a computer on your Wi-Fi read your ForkLift data."
      }
    },
    "android": {
      "package": "app.forklift",
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_DATA_SYNC",
        "POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#E8590C"
        }
      ],
      "expo-sharing",
      "expo-secure-store",
      "./plugins/withAiAccessService"
    ]
  }
}
