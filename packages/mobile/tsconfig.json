{
  "extends": [
    "expo/tsconfig.base",
    "@forklift/tsconfig/base.json"
  ],
  "compilerOptions": {
    "rootDir": ".",
    "types": [
      "jest"
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "nativewind-env.d.ts"
  ]
}