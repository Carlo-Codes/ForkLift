{
  "name": "@forklift/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "exports": {
    "./client": [
      "./src/client.index.ts"
    ],
    "./server": [
      "./src/server.index.ts"
    ]
  },
  "scripts": {
    "lint": "eslint .",
    "format": "eslint --fix .",
    "typecheck": "tsc --noEmit",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --silent=false --detectOpenHandles",
    "db:generate": "drizzle-kit generate --config ../../drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config ../../drizzle.config.ts"
  },
  "dependencies": {
    "better-sqlite3": "^12.4.1",
    "drizzle-orm": "1.0.0-rc.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@forklift/eslint-config": "workspace:*",
    "@forklift/jest-config": "workspace:*",
    "@forklift/prettier-config": "workspace:*",
    "@forklift/tsconfig": "workspace:*",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.0",
    "drizzle-kit": "1.0.0-rc.5",
    "eslint": "^9",
    "jest": "~30.5.2",
    "ts-jest": "^29.4.15",
    "typescript": "^6"
  },
  "prettier": "@forklift/prettier-config"
}
