{
  "name": "@forklift/eslint-config",
  "version": "0.2.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "exports": {
    "./base": "./base.js",
    "./react": "./react.js"
  },
  "files": [
    "./base.js",
    "./react.js"
  ],
  "scripts": {
    "clean:self": "rm -rf .turbo node_modules",
